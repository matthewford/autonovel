# Model backend: hermes or anthropic
AUTONOVEL_LLM_BACKEND=hermes

# Hermes backend defaults. Override per role with:
# AUTONOVEL_HERMES_WRITER_MODEL, AUTONOVEL_HERMES_JUDGE_MODEL,
# AUTONOVEL_HERMES_REVIEWER_MODEL, AUTONOVEL_HERMES_READER_MODEL.
# Optional. Leave blank unless you have created a Hermes profile for autonovel.
AUTONOVEL_HERMES_PROFILE=
AUTONOVEL_HERMES_PROVIDER=zai
AUTONOVEL_HERMES_MODEL=glm-5.1
AUTONOVEL_HERMES_TOOLSETS=file,safe
AUTONOVEL_HERMES_USE_GOALS=true

# Anthropic API key (required only when AUTONOVEL_LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Writer model (used for drafting and revision)
AUTONOVEL_WRITER_MODEL=claude-sonnet-4-6

# Judge model (used for evaluation — should differ from writer)
AUTONOVEL_JUDGE_MODEL=claude-opus-4-6

# Review model (Opus — deep prose-level analysis, used in Phase 3b)
AUTONOVEL_REVIEW_MODEL=claude-opus-4-6

# API base URL
AUTONOVEL_API_BASE_URL=https://api.anthropic.com

# fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# Audiobook generation. Default matches Hermes local TTS:
# pocket-tts via /home/hermes/.hermes/scripts/pocket_tts_provider.py, voice Samantha.
AUTONOVEL_AUDIOBOOK_PROVIDER=pocket-tts
AUTONOVEL_POCKET_TTS_VOICE=Samantha
AUTONOVEL_POCKET_TTS_LANGUAGE=english
AUTONOVEL_POCKET_TTS_DEVICE=cpu
AUTONOVEL_POCKET_TTS_HERMES_HOME=/home/hermes/.hermes

# ElevenLabs API key, only needed when AUTONOVEL_AUDIOBOOK_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
MLX_TTS_SERVER_URL=http://localhost:8000
